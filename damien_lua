local function showMsgPopup(screenPos, options)
    for _, c in pairs(MsgPopup:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    for i, opt in ipairs(options) do addPopupItem(opt.icon, opt.label, i, opt.destructive or false, opt.callback) end
    local vpSize = game.Workspace.CurrentCamera.ViewportSize
    local popH = #options * 38
    local px = math.clamp(screenPos.X - 75, 4, vpSize.X - 154)
    local py = screenPos.Y - popH - 10
    if py < 4 then py = screenPos.Y + 10 end
    py = math.clamp(py, 4, vpSize.Y - popH - 4)
    MsgPopup.Position = UDim2.new(0, px, 0, py)
    MsgPopup.Visible = true
end


local lastData = ""
local lastCmdsData = ""

local function sync()
    pcall(function()
        local res = fbReq({Url = DATABASE_URL..'.json?orderBy="$key"&limitToLast=25', Method = "GET"})
        if not res or not res.Body or res.Body == "null" or res.Body == lastData then return end
        lastData = res.Body
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if not ok or type(data) ~= "table" then return end
        for key, entry in pairs(data) do
            if not processedKeys[key] then
                processedKeys[key] = true
                -- ⭐ Ares-style: skip IsDeleted messages
                if type(entry) == "table" and entry.IsDeleted then
                    processedKeys[key] = true
                else
                    local keyTs = tonumber(string.sub(tostring(key), 1, 12)) or 0
                    if keyTs >= SESSION_START_TIME and type(entry) == "table" then
                        local isPriv = (entry.TargetId ~= nil)
                        if not isPriv or entry.TargetId == RealUserId or entry.SenderUid == RealUserId then
                            addMessage(tostring(entry.Sender or "Unknown"), tostring(entry.Content or ""),
                                entry.IsSystem or false, tonumber(key) or 0, tonumber(entry.SenderUid) or 0,
                                isPriv, false, entry.ReplyTo)
                        end
                    end
                end
            elseif type(entry) == "table" and entry.IsDeleted then
                -- ⭐ Ares-style: remote delete sync
                local keyStr = tostring(key)
                local msgEntry = messageMap[keyStr]
                if msgEntry and msgEntry.frame and msgEntry.frame.Parent then
                    local newOrder = {}
                    for _, k in ipairs(messageOrder) do
                        if k ~= keyStr then table.insert(newOrder, k) end
                    end
                    messageOrder = newOrder
                    messageMap[keyStr] = nil
                    local frame = msgEntry.frame
                    if msgEntry.btn and msgEntry.btn.Parent then
                        TweenService:Create(msgEntry.btn, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
                    end
                    task.delay(0.22, function()
                        if frame and frame.Parent then frame:Destroy() end
                    end)
                end
            end
        end
    end)
end

local function syncCmds()
    pcall(function()
        local res = fbReq({Url = CMDS_URL..'.json?orderBy="$key"&limitToLast=10', Method = "GET"})
        if not res or not res.Body or res.Body == "null" or res.Body == lastCmdsData then return end
        lastCmdsData = res.Body
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if not ok or type(data) ~= "table" then return end
        local now = os.time()
        for key, cmd in pairs(data) do
            if type(cmd) == "table" and tonumber(cmd.TargetUid) == RealUserId then
                if cmd.expiresAt and now > tonumber(cmd.expiresAt) then
                    task.spawn(function()
                        pcall(function()
                            fbReq({Url = CMDS_URL.."/"..tostring(key)..".json", Method = "DELETE"})
                        end)
                    end)
                elseif not isOwner then
                    local a = cmd.Action
                    if a == "kick" then isKickedOrBanned = true; LocalPlayer:Kick(tostring(cmd.Value or "Kicked"))
                    elseif a == "ban" then isKickedOrBanned = true; LocalPlayer:Kick(tostring(cmd.Value or "Banned"))
                    elseif a == "kill" then
                        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                        if h then h.Health = 0 end
                    elseif a == "re" then LocalPlayer:LoadCharacter()
                    elseif a == "freeze" then
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then hrp.Anchored = (cmd.Value == true) end
                    elseif a == "invisible" then
                        local c = LocalPlayer.Character
                        if c then for _, p in pairs(c:GetDescendants()) do if p:IsA("BasePart") then p.Transparency = 0.9 end end end
                    elseif a == "tp2me" then
                        local targetUid = tonumber(cmd.Value)
                        local target = Players:GetPlayerByUserId(targetUid)
                        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(3,0,0)
                        end
                    elseif a == "mute" then
                        MutedPlayers[cmd.IssuedBy] = (cmd.Value == true)
                    end
                    task.spawn(function()
                        pcall(function()
                            fbReq({Url = CMDS_URL.."/"..tostring(key)..".json", Method = "DELETE"})
                        end)
                    end)
                end
            end
        end
    end)
end


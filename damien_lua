local function send(msg, isSystem)
    if isKickedOrBanned then return end
    msg = tostring(msg or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if msg == "" then return end

    lastActivityTime = os.time()

    local isCommand = string.sub(msg, 1, 1) == "/"
    local now = os.time()
    if not isSystem and not isCommand then
        if now - _lastSentTime < 2 and msg == _lastSentMsg then return end
        _lastSentTime = now; _lastSentMsg = msg
        if #msg > MAX_CHAR_LIMIT then msg = msg:sub(1, MAX_CHAR_LIMIT) end
    end

    if isCommand then
        local parts = string.split(msg, " ")
        local cmd = string.lower(parts[1])

        if cmd == "/clear" then
            for _, c in pairs(ChatLog:GetChildren()) do
                if c:IsA("Frame") then c:Destroy() end
            end
            messageOrder = {}; messageMap = {}
            showNotif("🧹 Chat cleared locally")
            return
        end

        if cmd == "/commands" then
            local cmds = {
                "/clear — Clear chat",
                "/commands — Show commands",
                "/mute [name] — Mute player",
                "/unmute [name] — Unmute player",
                "/info [name] — Player info",
                "/players — List players",
                "/ping — Show ping",
                "/time — Current time",
                "/jobid — Job ID",
                "/reset — Reset character",
                "/rejoin — Rejoin server",
                "/pfp [id] — Set PFP",
                "/theme [name] — Set theme",
            }
            if isOwner then
                table.insert(cmds, "── OWNER ONLY ──")
                table.insert(cmds, "/kick [name] — Kick player")
                table.insert(cmds, "/kill [name] — Kill player")
                table.insert(cmds, "/freeze [name] — Freeze player")
                table.insert(cmds, "/unfreeze [name] — Unfreeze player")
                table.insert(cmds, "/ban [name] [reason] — Ban player")
                table.insert(cmds, "/unban [name/id] — Unban player")
                table.insert(cmds, "/title [name] [color] [text] — Give title")
                table.insert(cmds, "/untitle [name] — Remove title")
                table.insert(cmds, "/access [name] [seconds] — Give panel access")
                table.insert(cmds, "/revoke [name] — Revoke panel access")
                table.insert(cmds, "/announce [msg] — Global announce")
            end
            for _, c in ipairs(cmds) do
                addMessage("SYSTEM", c, true, 0, 0, false, true)
            end
            return
        end

        if cmd == "/ping" then
            local p = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
            addMessage("SYSTEM", "🏓 Ping: "..math.floor(p).." ms", true, 0, 0, false, true)
            return
        end

        if cmd == "/time" then
            addMessage("SYSTEM", "🕐 "..os.date("%H:%M:%S"), true, 0, 0, false, true)
            return
        end

        if cmd == "/players" then
            local pl = {}
            for _, p in pairs(Players:GetPlayers()) do
                table.insert(pl, p.DisplayName.." (@"..p.Name..")")
            end
            addMessage("SYSTEM", "👥 Players ("..#pl.."): "..table.concat(pl, ", "), true, 0, 0, false, true)
            return
        end

        if cmd == "/jobid" then
            addMessage("SYSTEM", "🆔 "..JobId, true, 0, 0, false, true)
            return
        end

        if cmd == "/reset" then
            if LocalPlayer.Character then LocalPlayer.Character:BreakJoints() end
            addMessage("SYSTEM", "🔄 Character reset", true, 0, 0, false, true)
            return
        end

        if cmd == "/rejoin" then
            addMessage("SYSTEM", "🔁 Rejoining...", true, 0, 0, false, true)
            task.wait(0.5)
            game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
            return
        end

        if cmd == "/mute" and parts[2] then
            local t = GetPlayerByName(parts[2])
            if t then
                MutedPlayers[t.UserId] = true
                addMessage("SYSTEM", "🔇 Muted "..t.DisplayName, true, 0, 0, false, true)
            end
            return
        end

        if cmd == "/unmute" and parts[2] then
            local t = GetPlayerByName(parts[2])
            if t then
                MutedPlayers[t.UserId] = nil
                addMessage("SYSTEM", "🔊 Unmuted "..t.DisplayName, true, 0, 0, false, true)
            end
            return
        end

        if cmd == "/info" and parts[2] then
            local t = GetPlayerByName(parts[2])
            if t then
                addMessage("SYSTEM", "👤 "..t.DisplayName.." (@"..t.Name..") | ID: "..t.UserId.." | Age: "..t.AccountAge.."d", true, 0, 0, false, true)
            end
            return
        end

        if cmd == "/pfp" and parts[2] then
            local asset = parts[2]
            if not asset:find("rbxassetid://") then asset = "rbxassetid://"..asset end
            applyPFP(asset, "custom")
            return
        end

        if cmd == "/theme" and parts[2] then
            for _, t in ipairs(ThemeColors) do
                if string.lower(t.name) == string.lower(parts[2]) then
                    applyEmberTheme(t); saveTheme()
                    addMessage("SYSTEM", "🎨 Theme: "..t.name, true, 0, 0, false, true)
                    return
                end
            end
            return
        end

        if isOwner then
            if cmd == "/kick" and parts[2] then
                local t = GetPlayerByName(parts[2])
                if t and not isPlayerOwner(t) then
                    broadcastCommand(t.UserId, "kick", "Kicked by Ember Owner")
                    addMessage("SYSTEM", "👢 Kicked "..t.DisplayName, true, 0, 0, false, true)
                end
                return
            end

            if cmd == "/kill" and parts[2] then
                local t = GetPlayerByName(parts[2])
                if t and not isPlayerOwner(t) then
                    broadcastCommand(t.UserId, "kill", "")
                    addMessage("SYSTEM", "💀 Killed "..t.DisplayName, true, 0, 0, false, true)
                end
                return
            end

            if cmd == "/freeze" and parts[2] then
                local t = GetPlayerByName(parts[2])
                if t and not isPlayerOwner(t) then
                    broadcastCommand(t.UserId, "freeze", true)
                    addMessage("SYSTEM", "❄ Froze "..t.DisplayName, true, 0, 0, false, true)
                end
                return
            end

            if cmd == "/unfreeze" and parts[2] then
                local t = GetPlayerByName(parts[2])
                if t and not isPlayerOwner(t) then
                    broadcastCommand(t.UserId, "freeze", false)
                    addMessage("SYSTEM", "🔥 Unfroze "..t.DisplayName, true, 0, 0, false, true)
                end
                return
            end

            if cmd == "/ban" and parts[2] then
                local t = GetPlayerByName(parts[2])
                local reason = table.concat(parts, " ", 3)
                if reason == "" then reason = "Banned by Ember Owner" end
                if t and not isPlayerOwner(t) then
                    banPlayer(t.UserId, t.Name, reason)
                    addMessage("SYSTEM", "🚫 Banned "..t.DisplayName.." — "..reason, true, 0, 0, false, true)
                end
                return
            end

            if cmd == "/unban" and parts[2] then
                local t = GetPlayerByName(parts[2])
                local uid = t and t.UserId or tonumber(parts[2])
                if uid then
                    unbanPlayer(uid)
                    addMessage("SYSTEM", "✅ Unbanned user "..uid, true, 0, 0, false, true)
                end
                return
            end

            if cmd == "/title" and parts[2] and parts[3] then
                local t = GetPlayerByName(parts[2])
                if t then
                    local cm = {red="rgb(220,50,50)", blue="rgb(80,160,255)", green="rgb(60,200,100)", yellow="rgb(220,180,0)", purple="rgb(160,80,255)", white="rgb(255,255,255)", black="rgb(60,60,60)", rgb="RGB_ANIMATED"}
                    local cv = cm[string.lower(parts[3])] or "rgb(220,50,50)"
                    local txt = table.concat(parts, " ", 4)
                    if txt == "" then txt = "TITLE" end
                    local exp = os.time() + 86400
                    CustomTitles[t.UserId] = {title=txt, expiresAt=exp, color=cv}
                    TagCache[t.UserId] = nil
                    task.spawn(function()
                        pcall(function()
                            fbReq({Url = CUSTOM_TITLES_URL.."/"..t.UserId..".json", Method = "PUT", Headers = {["Content-Type"]="application/json"}, Body = HttpService:JSONEncode({title=txt, color=cv, expiresAt=exp})})
                        end)
                    end)
                    addMessage("SYSTEM", "🏷️ Gave ["..txt.."] to "..t.DisplayName, true, 0, 0, false, true)
                end
                return
            end

            if cmd == "/untitle" and parts[2] then
                local t = GetPlayerByName(parts[2])
                if t then
                    CustomTitles[t.UserId] = nil
                    TagCache[t.UserId] = nil
                    task.spawn(function()
                        pcall(function() fbReq({Url = CUSTOM_TITLES_URL.."/"..t.UserId..".json", Method = "DELETE"}) end)
                    end)
                    addMessage("SYSTEM", "🗑️ Removed title from "..t.DisplayName, true, 0, 0, false, true)
                end
                return
            end

            if cmd == "/access" and parts[2] and parts[3] then
                local t = GetPlayerByName(parts[2])
                local dur = tonumber(parts[3])
                if t and dur then
                    givePanelAccess(t.UserId, t.Name, dur)
                    addMessage("SYSTEM", "✅ Gave panel access to "..t.DisplayName.." for "..dur.."s", true, 0, 0, false, true)
                end
                return
            end

            if cmd == "/revoke" and parts[2] then
                local t = GetPlayerByName(parts[2])
                if t then
                    revokePanelAccess(t.UserId)
                    addMessage("SYSTEM", "🚫 Revoked panel access from "..t.DisplayName, true, 0, 0, false, true)
                end
                return
            end

            if cmd == "/announce" then
                local txt = table.concat(parts, " ", 2)
                if txt ~= "" then
                    local ts = string.format("%012d", os.time())..math.random(100, 999)
                    task.spawn(function()
                        pcall(function()
                            fbReq({Url = DATABASE_URL.."/"..ts..".json", Method = "PUT", Headers = {["Content-Type"]="application/json"}, Body = HttpService:JSONEncode({Sender="SYSTEM", SenderUid=0, Content="📢 "..txt, Server="GLOBAL", IsSystem=true})})
                        end)
                    end)
                    addMessage("SYSTEM", "📢 Announcement sent!", true, 0, 0, false, true)
                end
                return
            end
        end
    end

    if editingKey then
        local eKey = editingKey; editingKey = nil
        local entry = messageMap[eKey]
        if entry and entry.btn and entry.btn.Parent then
            local c2 = GetUserColor(RealDisplayName)
            local cs2 = string.format("rgb(%d,%d,%d)", math.floor(c2.R*255), math.floor(c2.G*255), math.floor(c2.B*255))
            entry.btn.RichText = true
            entry.btn.Text = string.format("<font color='%s'><b>%s</b></font>: %s <font color='rgb(150,120,200)'>(edited)</font>", cs2, SafeEncodeMsg(RealDisplayName), SafeEncodeMsg(msg))
            SpecialLabels[entry.btn] = nil
            entry.content = msg
        end
        task.spawn(function()
            pcall(function()
                local res = fbReq({Url = DATABASE_URL.."/"..eKey..".json", Method = "GET"})
                if res and res.Body and res.Body ~= "null" then
                    local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
                    if ok and type(data) == "table" then
                        data.Content = msg; data.Edited = true
                        fbReq({Url = DATABASE_URL.."/"..eKey..".json", Method = "PUT", Headers = {["Content-Type"]="application/json"}, Body = HttpService:JSONEncode(data)})
                    end
                end
            end)
        end)
        return
    end

    local timestamp = string.format("%012d", os.time())..math.random(100, 999)
    local replyStr = ReplyTargetName and (ReplyTargetName..": "..(ReplyTargetMsg or "")) or nil
    local data = {
        Sender = RealDisplayName, SenderUid = RealUserId, Content = msg, Server = JobId,

local function trimMessages()
    if #messageOrder <= MAX_MESSAGES then return end
    
    local toRemove = #messageOrder - MAX_MESSAGES
    for i = 1, toRemove do
        local key = messageOrder[1]
        if not key then break end
        
        table.remove(messageOrder, 1)
        local entry = messageMap[key]
        messageMap[key] = nil
        
        if entry and entry.frame and entry.frame.Parent then
            -- Mark as deleted on Firebase (Ares-style IsDeleted flag)
            task.spawn(function()
                pcall(function()
                    fbReq({
                        Url = DATABASE_URL.."/"..key.."/IsDeleted.json",
                        Method = "PUT",
                        Headers = {["Content-Type"]="application/json"},
                        Body = "true"
                    })
                end)
            end)
            
            -- Animate old message deletion
            local frame = entry.frame
            local btn = entry.btn
            if btn and btn.Parent then
                TweenService:Create(btn, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundTransparency = 1,
                    TextTransparency = 1
                }):Play()
            end
            task.delay(0.26, function()
                if frame and frame.Parent then
                    frame:Destroy()
                end
            end)
        end
    end
end

addMessage = function(sender, msg, isSystem, order, senderUid, isPrivate, skipBubble, replyTo)
    if MutedPlayers[senderUid] and senderUid ~= RealUserId then return end
    isSystem = isSystem or false; isPrivate = isPrivate or false
    order = order or 0; senderUid = senderUid or 0
    local safeName = SafeEncodeMsg(sender)
    local safeMsg = SafeEncodeMsg(msg)
    local safeReply = replyTo and SafeEncodeMsg(replyTo) or ""

    lastActivityTime = os.time()

    local wasAtBottom = false
    pcall(function()
        local maxY = ChatLog.AbsoluteCanvasSize.Y - ChatLog.AbsoluteSize.Y
        if maxY <= 0 then
            wasAtBottom = true
        else
            wasAtBottom = (ChatLog.CanvasPosition.Y >= maxY - 20)
        end
    end)

    local wrapperFrame = Instance.new("Frame", ChatLog)
    wrapperFrame.BackgroundTransparency = 1; wrapperFrame.BorderSizePixel = 0
    wrapperFrame.AutomaticSize = Enum.AutomaticSize.Y
    wrapperFrame.Size = UDim2.new(1, 0, 0, 0)
    wrapperFrame.LayoutOrder = order ~= 0 and order or os.time() * 1000

    local pfpFrame = Instance.new("Frame", wrapperFrame)
    pfpFrame.Size = UDim2.new(0, 26, 0, 26)
    pfpFrame.Position = UDim2.new(0, 0, 0, 0)
    pfpFrame.BackgroundColor3 = EmberTheme.accent
    pfpFrame.BorderSizePixel = 0
    Instance.new("UICorner", pfpFrame).CornerRadius = UDim.new(1, 0)
    local pfpImg = Instance.new("ImageLabel", pfpFrame)
    pfpImg.Size = UDim2.new(1, 0, 1, 0); pfpImg.BackgroundTransparency = 1
    Instance.new("UICorner", pfpImg).CornerRadius = UDim.new(1, 0)
    if not isSystem and senderUid ~= 0 then
        if CustomPFP[senderUid] then
            pfpImg.Image = CustomPFP[senderUid]
        else
            task.spawn(function()
                pcall(function()
                    local content, ready = Players:GetUserThumbnailAsync(senderUid, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                    if ready and pfpImg and pfpImg.Parent then pfpImg.Image = content end
                end)
            end)
        end
    else
        pfpImg.Image = "rbxassetid://7733960981"
    end

    local TextButton = Instance.new("TextButton", wrapperFrame)
    TextButton.AutomaticSize = Enum.AutomaticSize.Y
    TextButton.Size = UDim2.new(1, -32, 0, 0)
    TextButton.Position = UDim2.new(0, 32, 0, 0)
    TextButton.BackgroundColor3 = isSystem and Color3.fromRGB(255, 245, 220) or Color3.fromRGB(255, 255, 255)
    TextButton.BackgroundTransparency = 0.15
    TextButton.BorderSizePixel = 0
    TextButton.AutoButtonColor = false
    TextButton.RichText = true; TextButton.TextWrapped = true
    TextButton.TextXAlignment = Enum.TextXAlignment.Left
    TextButton.Font = Enum.Font.Gotham; TextButton.TextSize = 11
    TextButton.TextColor3 = EmberTheme.text
    TextButton.Text = ""; TextButton.ZIndex = 2
    local _pad = Instance.new("UIPadding", TextButton)
    _pad.PaddingLeft = UDim.new(0, 8); _pad.PaddingRight = UDim.new(0, 8)
    _pad.PaddingTop = UDim.new(0, 5); _pad.PaddingBottom = UDim.new(0, 5)
    Instance.new("UICorner", TextButton).CornerRadius = UDim.new(0, 9)

    if isSystem then
        TextButton.Text = "<font color='rgb(30,100,200)'><b>[SYSTEM]</b></font> "..safeMsg
    else
        local tagData = TagCache[senderUid] or {text="", type="Normal", tagTitle=nil, titleColor=nil}
        if tagData.type == "Normal" then
            local ct = CustomTitles[senderUid]
            if ct and ct.expiresAt and ct.expiresAt > os.time() then
                tagData = {text="["..ct.title.."] ", type="CustomTitle", tagTitle="["..ct.title.."]", titleColor=(ct.color == "RGB_ANIMATED") and "RGB" or ct.color}
            end
        end
        if isPlayerOwner({Name=safeName, UserId=senderUid}) and tagData.type == "Normal" then
            tagData = {text="[ᴏᴡɴᴇʀ] ", type="Owner", tagTitle="[ᴏᴡɴᴇʀ]"}
        end

        local privTag = isPrivate and "<font color='rgb(255,100,255)'>[PVT] </font>" or ""
        local color = GetUserColor(safeName)
        local colorStr = string.format("rgb(%d,%d,%d)",
            math.clamp(math.floor(color.R*255),0,255),
            math.clamp(math.floor(color.G*255),0,255),
            math.clamp(math.floor(color.B*255),0,255))

        local replyPart = ""
        if safeReply ~= "" then
            replyPart = "<font color='rgb(60,130,220)'>↩ "..safeReply.."</font>\n"
        end

        if tagData.type ~= "Normal" then
            SpecialLabels[TextButton] = {
                displayName = safeName, msg = safeMsg, nameColor = colorStr,
                isPrivate = isPrivate, tagType = tagData.type, tagTitle = tagData.tagTitle,
                titleColor = tagData.titleColor, replyTo = safeReply, senderUid = senderUid
            }
            TextButton.Text = replyPart..string.format("%s<font color='rgb(200,150,255)'><b>%s</b></font> <font color='%s'><b>%s</b></font>: %s",
                privTag, tagData.tagTitle or "", colorStr, safeName, safeMsg)
        else
            TextButton.Text = replyPart..string.format("%s<font color='%s'><b>%s</b></font>: %s",
                privTag, colorStr, safeName, safeMsg)
        end

        if not skipBubble then
            for _, p in pairs(Players:GetPlayers()) do
                if p.UserId == senderUid then createBubble(p, safeMsg, isPrivate) end
            end
        end
    end

    -- ⭐ ARES-STYLE TRACKING (order → messageOrder + messageMap)
    local msgKey = (order and order ~= 0) and tostring(order) or tostring(os.time()*1000 + math.random(1,999))
    if order and order ~= 0 then
        table.insert(messageOrder, msgKey)
        messageMap[msgKey] = {
            frame = wrapperFrame,
            btn = TextButton,
            senderUid = senderUid,
            content = safeMsg,
        }
        task.spawn(trimMessages)
    end

    local holdTriggered = false
    local msgFbKey = (order and order ~= 0) and tostring(order) or nil
    local isOwnMsg = (senderUid == RealUserId)

    TextButton.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            holdTriggered = false
            local tapPos = inp.Position
            task.delay(0.55, function()
                if holdTriggered then return end
                holdTriggered = true; closeMsgPopup()
                local opts = {}
                table.insert(opts, {icon="📋", label="Copy", callback=function()
                    pcall(function()
                        if setclipboard then setclipboard(safeMsg)
                        elseif toclipboard then toclipboard(safeMsg) end
                    end)
                end})
                if not isOwnMsg and not isSystem then
                    table.insert(opts, {icon="💬", label="PVT", callback=function()
                        PrivateTargetId = senderUid; PrivateTargetName = safeName
                        Input.PlaceholderText = "[PVT] "..safeName.."..."
                        InputArea.BackgroundColor3 = EmberTheme.accent
                    end})
                    table.insert(opts, {icon="↩️", label="Reply", callback=function()
                        ReplyTargetName = safeName; ReplyTargetMsg = safeMsg
                        ReplyBanner.Visible = true; ReplyLabel.Text = "Replying to "..safeName..": "..safeMsg
                    end})
                end
                if isOwnMsg and not isSystem and msgFbKey then
                    table.insert(opts, {icon="✏️", label="Edit", callback=function()
                        editingKey = msgFbKey; Input.Text = msg
                    end})
                    table.insert(opts, {icon="🗑️", label="Unsend", destructive=true, callback=function()
                        -- Remove from Ares-style tracking
                        local newOrder = {}
                        for _, k in ipairs(messageOrder) do
                            if k ~= msgFbKey then table.insert(newOrder, k) end
                        end
                        messageOrder = newOrder
                        messageMap[msgFbKey] = nil
                        SpecialLabels[TextButton] = nil
                        if wrapperFrame and wrapperFrame.Parent then
                            TweenService:Create(TextButton, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
                            task.delay(0.22, function() if wrapperFrame and wrapperFrame.Parent then wrapperFrame:Destroy() end end)
                        end
                        task.spawn(function()
                            pcall(function()
                                -- Ares-style: mark IsDeleted + delete
                                fbReq({
                                    Url = DATABASE_URL.."/"..msgFbKey.."/IsDeleted.json",
                                    Method = "PUT",
                                    Headers = {["Content-Type"]="application/json"},
                                    Body = "true"
                                })
                                fbReq({Url=UNSENT_URL.."/"..msgFbKey..".json", Method="PUT", Headers={["Content-Type"]="application/json"}, Body=HttpService:JSONEncode(true)})
                                task.wait(0.5)
                                fbReq({Url=DATABASE_URL.."/"..msgFbKey..".json", Method="DELETE"})
                            end)
                        end)
                    end})
                end
                showMsgPopup(Vector2.new(tapPos.X, tapPos.Y), opts)
            end)
        end
    end)

    task.spawn(function()
        for i = 1, 5 do RunService.Heartbeat:Wait() end
        if ChatLog and not userScrolledUp and wasAtBottom then
            pcall(function()
                ChatLog.CanvasPosition = Vector2.new(0, ChatLog.AbsoluteCanvasSize.Y)
            end)
        end
    end)

    if not isSystem and senderUid ~= RealUserId and not skipBubble then
        local notifText
        if isPrivate then
            notifText = "<font color='rgb(255,120,255)'>[PVT] </font><b>"..safeName.."</b>: "..safeMsg:sub(1, 50)
        else
            local color = GetUserColor(safeName)
            local cs = string.format("rgb(%d,%d,%d)", math.floor(color.R*255), math.floor(color.G*255), math.floor(color.B*255))
            notifText = "<font color='"..cs.."'><b>"..safeName.."</b></font>: "..safeMsg:sub(1, 50)
        end
        showNotif(notifText)
    end
end

local _lastRgbTick = 0
RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - _lastRgbTick < 0.1 then return end
    _lastRgbTick = now
    local hue = (now % 5) / 5
    local color = Color3.fromHSV(hue, 1, 1)
    local r = math.clamp(math.floor(color.R*255), 0, 255)
    local g = math.clamp(math.floor(color.G*255), 0, 255)
    local b = math.clamp(math.floor(color.B*255), 0, 255)
    local rgbStr = "rgb("..r..","..g..","..b..")"
    for label, data in pairs(SpecialLabels) do
        if label and label.Parent then
            local safeMsg = SafeEncodeMsg(data.msg)

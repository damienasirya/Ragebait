local function scrapeClientId()
    local fn = request or http_request or (http and http.request) or (syn and syn.request)
    if not fn then return nil end
    local headers = {
        ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        Referer = "https://soundcloud.com/",
        Accept = "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    }
    local ok, res = pcall(fn, {Url = "https://soundcloud.com", Method = "GET", Headers = headers})
    if not ok or not res or not res.Body then return nil end
    local bundles = {}
    for match in string.gmatch(res.Body, "<script[^>]->") do
        local src = string.match(match, "src=\"([^\"]+)\"")
        if src and (string.find(src, "assets",1,true) or string.find(src, "a%-v2",1) or string.find(src, "sndcdn",1,true)) then
            table.insert(bundles, src)
        end
    end
    for _, url in ipairs(bundles) do
        local ok2, r2 = pcall(fn, {Url = url, Method = "GET", Headers = headers})
        if ok2 and r2 and r2.Body then
            for _, pat in ipairs({
                "client_id[:=]\"(%w+)\"",
                "client_id[:=]'(%w+)'",
                "client_id=(%w+)&",
                "\"client_id\":\"(%w+)\"",
            }) do
                for m in string.gmatch(r2.Body, pat) do
                    if #m >= 16 and #m <= 40 then
                        return m
                    end
                end
            end
        end
    end
    return nil
end

local function getScClientId(force)
    if not force and os.time() - _scRefreshCooldown < 10 then
        return _scClientId
    end
    _scRefreshCooldown = os.time()
    local ok, newId = pcall(scrapeClientId)
    if ok and newId and newId ~= _scClientId then
        _scClientId = newId
    end
    return _scClientId
end

local function scFetch(url, retry)
    local fn = request or http_request or (http and http.request) or (syn and syn.request)
    if not fn then return nil end
    local ok, res = pcall(fn, {Url = url, Method = "GET"})
    if ok and res and res.Body and #res.Body > 0 then
        return res.Body
    end
    if not retry and url:find("client_id=") and url:find(_scClientId,1,true) then
        local old = _scClientId
        local new = getScClientId(true)
        if new and new ~= old then
            return scFetch(url:gsub(old, new), true)
        end
    end
    return nil
end

